{
  "expo": {
    "name": "나이스쿨",
    "slug": "school-app",
    "version": "1.0.3",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "schoolapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#D97757",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "io.github.eoris1225.neischool",
      "versionCode": 4,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "나이스쿨",
      "shortName": "나이스쿨",
      "lang": "ko",
      "description": "급식, 시간표, 학교 일정, 선생님께 질문하기까지 한곳에서 확인해요.",
      "display": "standalone",
      "startUrl": ".",
      "themeColor": "#D97757",
      "backgroundColor": "#F6F5F5"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 128,
          "backgroundColor": "#F6F5F5",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0F0D0D"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "쪽지에 사진을 붙이려면 앨범 접근이 필요해요."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/school-app"
    }
  }
}
