# 이 파일을 복사해서 .env 로 만들고 값을 채우세요. .env 는 커밋되지 않아요.
#
#   cp supabase/functions/.env.example supabase/functions/.env
#
# 로컬에서 함수를 띄울 때 supabase CLI가 .env 를 읽어요.
# 실제 배포에는 이 파일이 아니라 아래 명령으로 넣어요.
#
#   supabase secrets set NEIS_API_KEY=받은키

# open.neis.go.kr 에서 발급받은 인증키
NEIS_API_KEY=

# 학교 코드. 기본값은 서일여자고등학교(시범운영학교)라서 안 넣어도 돼요.
# 다른 학교로 바꾸려면 ?kind=school&name=학교이름 으로 찾아서 넣으세요.
NEIS_OFFICE_CODE=G10
NEIS_SCHOOL_CODE=7430062
